# Copy this file to ".env" and fill in ONE key. Both providers have a free tier (no credit card).
#   Groq    : https://console.groq.com/keys          (fast; ~30 requests/minute free)
#   Gemini  : https://aistudio.google.com/apikey     (~10 requests/minute free)
# You can also paste the key in the dashboard under Settings; it writes this file for you.

GROQ_API_KEY=
# GEMINI_API_KEY=

# Optional overrides (normally leave unset)
# LLM_PROVIDER=groq            # groq | gemini | openai (any OpenAI-compatible endpoint)
# LLM_MODEL=                   # auto-detected from the provider's model list when empty
# LLM_RPM=25                   # requests per minute the client allows itself
# LLM_BASE_URL=                # for OpenRouter / Ollama / OpenAI-compatible servers
# LLM_API_KEY=
